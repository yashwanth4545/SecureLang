{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "SecureLang",
  "patterns": [
    {
      "include": "#keywords"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#comments"
    }
  ],
  "repository": {
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.securelang",
          "match": "\\b(user|login|input|secure|authenticate)\\b"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.securelang",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.securelang",
          "match": "\\\\."
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.securelang",
          "match": "//.*$"
        }
      ]
    }
  },
  "scopeName": "source.sec"
}
