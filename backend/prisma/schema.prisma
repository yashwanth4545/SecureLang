generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id @default(uuid())
  username     String      @unique
  email        String      @unique
  passwordHash String
  role         Role        @default(USER)
  mfaEnabled   Boolean     @default(false)
  mfaSecret    String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  sessions     Session[]
  devices      Device[]
  auditLogs    AuditLog[]
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  
  @@index([userId])
}

model Device {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceFinger String
  isVerified   Boolean  @default(false)
  createdAt    DateTime @default(now())
  
  @@index([userId, deviceFinger])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  ipAddress String?
  metadata  Json?
  createdAt DateTime @default(now())
  
  @@index([userId])
  @@index([action])
}

enum Role {
  USER
  ADMIN
}
